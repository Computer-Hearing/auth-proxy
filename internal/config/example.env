ENV=development
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=10s

YAML_CONFIG_PATH="./config.yaml"

# гейт (auth-proxy)
GATEWAY_PORT=5000
GATEWAY_READ_TIMEOUT=5s
GATEWAY_WRITE_TIMEOUT=10s
# внешний адрес гейта - на него auth-сервис возвращает пользователя после логина/выхода
GATEWAY_BASE_URL=http://localhost:5000

# auth-сервис (второй слушатель в том же бинарнике)
AUTH_PORT=6000
AUTH_READ_TIMEOUT=5s
AUTH_WRITE_TIMEOUT=10s
AUTH_BASE_URL=http://localhost:6000
# CORS для auth-сервиса: разрешённые origin через запятую (напр. https://app.example.com).
# Пусто = Access-Control-Allow-Origin: * без Allow-Credentials (без кук).
AUTH_ALLOW_ORIGINS=
# куда ещё можно вернуть пользователя после логина (через запятую, точные или *.wildcard),
# помимо хоста GATEWAY_BASE_URL и host-ов маршрутов
AUTH_ALLOWED_REDIRECT_HOSTS=

# сессия: куки и JWT
SESSION_ACCESS_COOKIE=access_token
SESSION_REFRESH_COOKIE=refresh_token
# домен для кук (например .example.com) - кука будет доступна на всех поддоменах.
# Пустое = привязка к текущему хосту
SESSION_COOKIE_DOMAIN=
SESSION_ACCESS_SECRET=supersecret-access-key-32-chars-min
SESSION_REFRESH_SECRET=supersecret-refresh-key-32-chars-min
SESSION_ACCESS_TTL=15m
SESSION_REFRESH_TTL=24h

# роли и хеширование паролей
ACCESS_ROLES=user,admin,superadmin
ACCESS_BCRYPT_COST=12
