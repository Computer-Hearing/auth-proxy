LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

# Путь к статическому конфигу (gateway.yaml).
YAML_CONFIG_PATH=./gateway.yaml
# Путь к динамическому конфигу (routes.yaml). Обычно задаётся в gateway.yaml.
ROUTES_FILE=./routes.yaml

# Основной слушатель.
SERVER_PORT=5000
SERVER_READ_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=10s

# Слушатель админки.
ADMIN_PORT=7000
ADMIN_READ_TIMEOUT=5s
ADMIN_WRITE_TIMEOUT=10s

# Authentik.
AUTHENTIK_SECRET_HEADER=X-Proxy-Secret
AUTHENTIK_SECRET=
