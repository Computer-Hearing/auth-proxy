ENV=development

YAML_CONFIG_PATH="./config.yaml"

JWT_ACCESS_COOKIE_KEY=access_token
JWT_REFRESH_COOKIE_KEY=refresh_token
JWT_ACCESS_SECRET=supersecret-access-key-32-chars-min
JWT_REFRESH_SECRET=supersecret-refresh-key-32-chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=24h

# порт гейта (auth-proxy)
SERVER_PORT=5000
SERVER_READ_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=10s

# внешний адрес гейта - на него auth-сервис возвращает пользователя после логина/выхода
GATEWAY_BASE_URL=http://localhost:5000

# порт и внешний адрес auth-сервиса (второй слушатель в том же бинарнике)
AUTH_PORT=6000
AUTH_BASE_URL=http://localhost:6000

BCRYPT_COST=12

ROLES=user,admin,superadmin

DEFAULT_SUPERADMIN_USERNAME=vladosik
DEFAULT_SUPERADMIN_PASSWORD=vladosikpassword